{
    "name": "omniaglobal/omnia-packages",
    "description": "Shared Laravel packages for the Omnia Global products — Pulse, Campus and Vault.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3|^8.4",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "OmniaGlobal\\OmniaPackages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OmniaGlobal\\OmniaPackages\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OmniaGlobal\\OmniaPackages\\OmniaPackagesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
